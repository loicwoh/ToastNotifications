<LVClass LVVersion="20008000">
	<Property Name="NI.Lib.ContainingLib" Type="Str">ToastNotification.lvlib</Property>
	<Property Name="NI.Lib.ContainingLibPath" Type="Str">../../ToastNotification/ToastNotification.lvlib</Property>
	<Property Name="NI.Lib.Description" Type="Str">Concrete ToastSource owning a native ToastContentBuilder handle. Create ToastBuilder, compose text, text input and buttons with direct native calls, inspect XML and display through ToastService.Show. Show, Get XML and Close implement the source contract. Copies share one handle; one caller owns Close. Native references remain implementation details. See each method for error behavior and lifetime.</Property>
	<Property Name="NI.Lib.HelpPath" Type="Str"></Property>
