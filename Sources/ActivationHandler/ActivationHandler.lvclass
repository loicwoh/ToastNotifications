<LVClass LVVersion="20008000">
	<Property Name="NI.Lib.ContainingLib" Type="Str">ToastNotification.lvlib</Property>
	<Property Name="NI.Lib.ContainingLibPath" Type="Str">../../ToastNotification/ToastNotification.lvlib</Property>
	<Property Name="NI.Lib.Description" Type="Str">Dynamic-dispatch extension point for application toast activations. Pass a concrete child instance when registering callbacks and override Handle Activation. Use caller-owned queues or user events for shared state and long-running work. The current base implementation performs no action and propagates the incoming error; it displays no dialog. Protocol-activation buttons are handled by Windows rather than this handler.</Property>
	<Property Name="NI.Lib.HelpPath" Type="Str"></Property>
